# Copy to .env and fill in. Never commit .env.
PORT=3000
# 127.0.0.1 locally; 0.0.0.0 in a container / on a host (the Dockerfile sets this)
HOST=127.0.0.1
# Min 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Password for the seeded demo users (tom, lien, sarah, adviseur, ingest). Min 12 chars.
DEMO_PASSWORD=
# Enables /v1/demo/* (clock + reset). Set to false in anything that is not a demo.
DEMO_MODE=true
# Comma-separated allowed browser origins. Wildcard subdomains allowed: https://*.lovable.app
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://*.lovable.app,https://*.lovableproject.com
# true when running behind a reverse proxy (Railway, Render, Fly) so rate limiting sees the real client IP
TRUST_PROXY=false
